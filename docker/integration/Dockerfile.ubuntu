# Shall integration image — Ubuntu (apt). Build context = repo root.
#   docker build -f docker/integration/Dockerfile.ubuntu -t shall-it-ubuntu .
#   docker run --rm shall-it-ubuntu            # defaults to: apt jq
FROM ubuntu:24.04
ENV SHALL_IT_IMAGE=ubuntu
ENV DEBIAN_FRONTEND=noninteractive
# Essential toolchain + a broad set of language package managers so the harness can sweep
# many backends in one container (apt + npm + yarn + pnpm + pipx + uv + bun + cargo + gem).
# `sudo`, `util-linux` and `passwd` are the fixture for the privileged-path checks, not
# conveniences: every check above section 16f runs as root, so `run_on` never inserts `sudo` and
# the whole escalation path is dead code in a container. Driving it needs a user with a password
# (`chpasswd`, from `passwd`) and a real terminal (`script -e`, from `util-linux`) — without
# them that section reports "not driven here" and the most-used code path in the program stays
# unrun on every platform.
# `cron` and `init-system-helpers` are here so the harness can drive a `service:` statement
# without INSTALLING anything to do it. Section 14c installed cron itself at first, and apt
# upgraded `libsystemd0` and `libudev1` to satisfy it — which left the adoption manifest
# pinning versions the index no longer carried, so the next sync failed with
# `E: Version '255.4-1ubuntu8.16' for 'libsystemd0' was not found` and four assertions about
# services went red for a reason that had nothing to do with services. The image provides the
# subject; the harness drives Shall against it. That is the arrangement every other backend
# here already has.
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl ca-certificates build-essential pkg-config libssl-dev git unzip \
    sudo util-linux passwd cron init-system-helpers \
    nodejs npm python3 python3-pip pipx ruby
# Every network install below goes through this. One attempt was the wrong number: a
# best-effort install that fails once takes its manager out of the image, and `|| true`
# means nothing says so until the coverage ratchet goes red. See `retry.sh`.
COPY docker/integration/retry.sh /usr/local/bin/retry
RUN chmod 0755 /usr/local/bin/retry

RUN retry 'curl --proto =https --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal'
# Extra managers via their own installers. Tolerant (`|| true`): if any is unreachable at
# build time the image still builds; that backend simply won't be READY and is auto-skipped.
#
# **The tolerance is why `unzip` is in the list above.** bun's installer needs it, none of these
# images had it, and `|| true` turned `error: unzip is required to install bun` into a successful
# build with one manager missing from every run afterwards. A skip the sweep reports honestly is
# still a skip nobody reads, so the dependencies of these installers belong in the package list
# rather than in the tolerance.
RUN corepack enable || true
RUN retry 'curl -LsSf https://astral.sh/uv/install.sh | sh' || true
RUN retry 'curl -fsSL https://bun.sh/install | bash' || true
ENV PATH="/root/.local/bin:/root/.bun/bin:/root/.cargo/bin:${PATH}"
WORKDIR /src
COPY . /src
RUN cargo build --release && cp target/release/shall /usr/local/bin/shall && chmod 0755 /usr/local/bin/shall
ENTRYPOINT ["sh", "/src/docker/integration/run-in-container.sh"]
CMD ["apt", "jq"]
