# LiNix integration image — Ubuntu (apt). Build context = repo root.
#   docker build -f docker/integration/Dockerfile.ubuntu -t linix-it-ubuntu .
#   docker run --rm linix-it-ubuntu            # defaults to: apt jq
FROM ubuntu:24.04
ENV LINIX_IT_IMAGE=ubuntu
ENV DEBIAN_FRONTEND=noninteractive
# Essential toolchain + a broad set of language package managers so the harness can sweep
# many backends in one container (apt + npm + yarn + pnpm + pipx + uv + bun + cargo + gem).
# `sudo`, `util-linux` and `passwd` are the fixture for the privileged-path checks, not
# conveniences: every check above section 16f runs as root, so `run_on` never inserts `sudo` and
# the whole escalation path is dead code in a container. Driving it needs a user with a password
# (`chpasswd`, from `passwd`) and a real terminal (`script -e`, from `util-linux`) — without
# them that section reports "not driven here" and the most-used code path in the program stays
# unrun on every platform.
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl ca-certificates build-essential pkg-config libssl-dev git unzip \
    sudo util-linux passwd \
    nodejs npm python3 python3-pip pipx ruby
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal
# Extra managers via their own installers. Tolerant (`|| true`): if any is unreachable at
# build time the image still builds; that backend simply won't be READY and is auto-skipped.
#
# **The tolerance is why `unzip` is in the list above.** bun's installer needs it, none of these
# images had it, and `|| true` turned `error: unzip is required to install bun` into a successful
# build with one manager missing from every run afterwards. A skip the sweep reports honestly is
# still a skip nobody reads, so the dependencies of these installers belong in the package list
# rather than in the tolerance.
RUN corepack enable || true
RUN curl -LsSf https://astral.sh/uv/install.sh | sh || true
RUN curl -fsSL https://bun.sh/install | bash || true
ENV PATH="/root/.local/bin:/root/.bun/bin:/root/.cargo/bin:${PATH}"
WORKDIR /src
COPY . /src
RUN cargo build --release && cp target/release/linix /usr/local/bin/linix && chmod 0755 /usr/local/bin/linix
ENTRYPOINT ["sh", "/src/docker/integration/run-in-container.sh"]
CMD ["apt", "jq"]
