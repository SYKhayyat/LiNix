# Shall integration image — Arch Linux (pacman). Build context = repo root.
#   docker build -f docker/integration/Dockerfile.arch -t shall-it-arch .
#   docker run --rm shall-it-arch              # defaults to: pacman jq
FROM archlinux:latest
ENV SHALL_IT_IMAGE=arch
# Essential toolchain + a broad set of language package managers so the harness can sweep
# many backends in one container (pacman + npm + yarn + pnpm + pipx + uv + bun + cargo + gem).
RUN pacman -Syu --noconfirm \
    && pacman -S --noconfirm --needed curl gcc make pkgconf openssl perl git rustup unzip \
       nodejs npm python-pipx ruby \
    && rustup default stable
# Extra managers via their own installers. Tolerant (`|| true`): a build-time network hiccup
# leaves the image usable; that backend just won't be READY and is auto-skipped by the sweep.
#
# **The tolerance is why `unzip` is in the list above.** bun's installer needs it, none of
# these images had it, and `|| true` turned `error: unzip is required to install bun` into a
# successful build with one manager missing from every run afterwards. A skip the sweep
# reports honestly is still a skip nobody reads, so the dependencies of these installers
# belong in the package list rather than in the tolerance.
RUN corepack enable || true
# Every network install below goes through this. One attempt was the wrong number: a
# best-effort install that fails once takes its manager out of the image, and `|| true`
# means nothing says so until the coverage ratchet goes red. See `retry.sh`.
COPY docker/integration/retry.sh /usr/local/bin/retry
RUN chmod 0755 /usr/local/bin/retry

RUN retry 'curl -LsSf https://astral.sh/uv/install.sh | sh' || true
RUN retry 'curl -fsSL https://bun.sh/install | bash' || true
ENV PATH="/root/.local/bin:/root/.bun/bin:/root/.cargo/bin:${PATH}"
WORKDIR /src
COPY . /src
RUN cargo build --release && cp target/release/shall /usr/local/bin/shall && chmod 0755 /usr/local/bin/shall
ENTRYPOINT ["sh", "/src/docker/integration/run-in-container.sh"]
CMD ["pacman", "jq"]
