# LiNix integration image — "tools": Ubuntu base (apt as the native backend) PLUS a broad set
# of the ecosystem package managers, INITIALIZED so the harness runs a REAL install→list→remove
# lifecycle against each — not just a dry-run plan. Composer, Go, opam, LuaRocks, Nimble, Cabal,
# mix/Hex, Helm, krew, pixi, Spack, dotnet, pub(dart), conda, nix and flatpak all come up READY
# with their indexes/switches/compilers prepared.
#
#   docker build -f docker/integration/Dockerfile.tools -t linix-it-tools .
#   docker run --rm linix-it-tools                 # full REAL lifecycle (slow: source compiles)
#   docker run --rm -e FAST=1 linix-it-tools       # downgrade the heaviest compilers to plan-smoke
#
# The REAL run compiles Rust/OCaml/Haskell/Nim/HPC packages from source and can take 20–40 min;
# that is intentional (the release owner asked for real, not simulated, coverage). Use FAST=1
# for a quicker pass. Every extra manager is installed/inited BEST-EFFORT (`|| true`): if one is
# unavailable at build time the image still builds and that backend is simply not READY and
# auto-skipped (and the COVERAGE AUDIT records that honestly).
FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
ENV LANG=C.UTF-8

# Core toolchain + the language managers the base Ubuntu image already sweeps. This layer
# MUST succeed, so it lists only known-good package names.
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl ca-certificates gnupg git build-essential pkg-config libssl-dev \
        unzip xz-utils python3 python3-pip pipx \
        nodejs npm ruby bubblewrap
# apt-packaged expansion managers, installed one-per-package BEST-EFFORT: a name that's
# unavailable on this release is skipped instead of failing the whole image build. (nimble
# ships inside the `nim` package; `mix` inside `elixir`; `cabal` in `cabal-install`.) Also
# emacs (emacs backend), flatpak and dotnet so those backends come up READY.
RUN for p in php-cli composer golang-go opam lua5.4 luarocks nim \
             ghc cabal-install haskell-stack elixir \
             emacs-nox flatpak dotnet8; do \
        apt-get install -y --no-install-recommends "$p" || echo "SKIP unavailable apt pkg: $p"; \
    done; rm -rf /var/lib/apt/lists/*

# mise (dev-tool version manager) — installs to ~/.local/bin/mise.
RUN curl -fsSL https://mise.run | sh || true

# Miniforge (provides conda) — the conda backend. Pre-accept ToS + set conda-forge so a real
# `conda install` resolves without prompts.
RUN curl -fsSL -o /tmp/mf.sh "https://github.com/conda-forge/miniforge/releases/latest/download/Miniforge3-Linux-x86_64.sh" \
    && bash /tmp/mf.sh -b -p /opt/conda && rm -f /tmp/mf.sh \
    && /opt/conda/bin/conda config --system --set always_yes true \
    && /opt/conda/bin/conda config --system --add channels conda-forge || true

# Nix (single-user, no daemon) with flakes enabled — the nix backend uses `nix profile`. Symlink
# the binaries into /usr/local/bin (always on PATH) so `command -v nix` succeeds and the backend
# reports READY regardless of profile-script sourcing; enable flakes for `nixpkgs#hello`.
RUN mkdir -p /etc/nix && printf 'experimental-features = nix-command flakes\n' > /etc/nix/nix.conf
RUN sh -c 'curl -L https://nixos.org/nix/install | sh -s -- --no-daemon' \
    && for b in nix nix-env nix-collect-garbage nix-store; do \
         ln -sf "/nix/var/nix/profiles/default/bin/$b" "/usr/local/bin/$b" 2>/dev/null || true; \
       done \
    || echo "SKIP nix install"

# Rust (for a REAL `cargo install`), uv and bun — same installers as the base image.
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal || true
RUN curl -LsSf https://astral.sh/uv/install.sh | sh || true
RUN curl -fsSL https://bun.sh/install | bash || true

# Helm (cloud-native) — its plugin backend.
RUN curl -fsSL https://raw.githubusercontent.com/helm/helm/main/scripts/get-helm-3 | bash || true

# kubectl + krew (kubectl plugin manager); fetch the plugin index so `krew install ns` resolves.
RUN curl -fsSLo /usr/local/bin/kubectl \
        "https://dl.k8s.io/release/$(curl -fsSL https://dl.k8s.io/release/stable.txt)/bin/linux/amd64/kubectl" \
        && chmod +x /usr/local/bin/kubectl || true
RUN set -e; cd /tmp \
    && curl -fsSLO "https://github.com/kubernetes-sigs/krew/releases/latest/download/krew-linux_amd64.tar.gz" \
    && tar zxf krew-linux_amd64.tar.gz \
    && ./krew-linux_amd64 install krew \
    && /root/.krew/bin/kubectl-krew update || true

# asdf (version manager). Pin the last classic (shell) release v0.14.1: its `bin/asdf`
# launcher works standalone, unlike `main` (now a Go rewrite that would need `go build`).
RUN git clone --branch v0.14.1 --depth 1 https://github.com/asdf-vm/asdf.git /opt/asdf || true

# Dart SDK (provides the `pub` backend, invoked as `dart pub global`). Best-effort via
# Google's apt repo.
RUN curl -fsSL https://dl-ssl.google.com/linux/linux_signing_key.pub \
        | gpg --dearmor -o /usr/share/keyrings/dart.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/dart.gpg] https://storage.googleapis.com/download.dartlang.org/linux/debian stable main" \
        > /etc/apt/sources.list.d/dart.list \
    && apt-get update && apt-get install -y --no-install-recommends dart \
    && rm -rf /var/lib/apt/lists/* || true

# pixi (conda-like global installer) — installs to ~/.pixi/bin.
RUN curl -fsSL https://pixi.sh/install.sh | bash || true

# Spack (HPC) — cloned; its launcher lives at /opt/spack/bin/spack.
RUN git clone --depth 1 https://github.com/spack/spack.git /opt/spack || true

# Surface every tool's bin dir, INCLUDING the per-user global-install dirs the real lifecycle
# writes to: Go (~/go/bin), .NET global tools (~/.dotnet/tools), Dart pub (~/.pub-cache/bin),
# Cargo, krew, pixi, nix, asdf, spack, conda. Best-effort clones/installers that failed just
# leave a missing dir; PATH entries for absent dirs are harmless.
ENV GOPATH=/root/go
ENV PATH="/root/.local/bin:/root/.bun/bin:/root/.cargo/bin:/root/go/bin:/root/.dotnet/tools:/root/.pub-cache/bin:/root/.krew/bin:/root/.pixi/bin:/nix/var/nix/profiles/default/bin:/root/.nix-profile/bin:/opt/asdf/bin:/opt/asdf/shims:/opt/spack/bin:/opt/conda/bin:/usr/lib/dart/bin:${PATH}"

# Prepare each ecosystem so a REAL install resolves without interactive setup:
#  - opam: init a switch (sandboxing off — no nested namespaces in a container)
#  - cabal / nimble: refresh the package index so `cabal install` / `nimble install` find pkgs
#  - spack: detect the system compiler so `spack install zlib` builds instead of erroring
#  - flatpak: add the flathub remote so `flatpak install` has a source
#  - dart: warm pub so `dart pub global activate` works
# All best-effort; a step that can't complete just leaves that backend to soft-skip at runtime.
RUN opam init --disable-sandboxing --bare -y 2>/dev/null && opam switch create default 2>/dev/null || echo "SKIP opam init"
RUN (cabal update || true) 2>/dev/null; echo done
RUN (nimble -y refresh || true) 2>/dev/null; echo done
RUN (/opt/spack/bin/spack compiler find || true) 2>/dev/null; echo done
RUN (flatpak remote-add --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo || true) 2>/dev/null; echo done

# The layers above delete `/var/lib/apt/lists` to stay small, which leaves apt unable to
# answer `search` at runtime — so every unpinned name skipped the native manager and landed
# on a language registry. A real machine has an index; the sweep needs one to be testing apt
# at all. Last, so it is not thrown away again.
RUN apt-get update
WORKDIR /src
COPY . /src
RUN cargo build --release && cp target/release/linix /usr/local/bin/linix && chmod 0755 /usr/local/bin/linix
ENTRYPOINT ["sh", "/src/docker/integration/run-in-container.sh"]
CMD ["apt", "jq"]
